# Learning Assistant Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Required: OpenAI API Key
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# Database Configuration
# ===========================================
# For SQLite (development/single user):
DATABASE_URL=sqlite:///./data/learning_assistant.db

# For PostgreSQL (production/multi-user):
# DATABASE_URL=postgresql://user:password@localhost:5432/learning_assistant
POSTGRES_USER=learning_assistant
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=learning_assistant

# ===========================================
# Security
# ===========================================
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Optional: Redis Cache
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# LLM Configuration
# ===========================================
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Optional per-task models as JSON, e.g. {"intent": "gpt-4.1-nano", "critic": "gpt-4o-mini"}.
# Tasks: intent, critic, fact_extraction, query_expansion, research_plan, evidence_gaps, feed_evaluation,
#        feed_judge, profile_draft, profile_feedback, reading_path_plan, reading_path_order
MODEL_ROUTES=
# Optional: retried once on this model after an outage, rate limit or retired model
LLM_FALLBACK_MODEL=
# Token ceilings per request; optional agent steps stop early so the answer still fits
CHAT_TURN_TOKEN_BUDGET=50000
CODING_RUN_TOKEN_BUDGET=150000
FEED_TOKEN_BUDGET=60000
READING_PATH_TOKEN_BUDGET=30000
# Recommendation for users with a research profile (src/pipelines/feed/profile_feed.py).
# Each part can be switched off; the feed still works from the content channel alone.
# Graph: Semantic Scholar recommendations from pinned/saved papers. Trending: Hugging Face
# trending papers close to the profile. Judge: gpt-4o-mini judges ~30 shortlisted papers per feed.
FEED_GRAPH_CHANNEL_ENABLED=true
FEED_TRENDING_CHANNEL_ENABLED=true
FEED_LLM_JUDGE_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Coding Agent is off by default. Set PRACTICE_ENABLED=true for read-only public
# repository exploration and unexecuted paper code drafts. Running paper code
# additionally requires a separate, isolated HTTPS worker; never give the API a Docker socket.
PRACTICE_ENABLED=false
PRACTICE_WORKER_URL=
PRACTICE_WORKER_TOKEN=
# Optional, read-only (no scopes needed for public repos): lifts the 60 requests/hour GitHub API limit
GITHUB_TOKEN=

# Shared demo account ("Try the demo" on the landing page). Create it once with
# `python -m src.jobs.seed_demo`. Model-backed actions are capped per visitor and per day.
DEMO_ENABLED=false
DEMO_ACTIONS_PER_VISITOR_PER_DAY=8
DEMO_ACTIONS_TOTAL_PER_DAY=150

# Optional LangSmith tracing of every agent run (OpenAI calls, tools, LangGraph nodes).
# Prompts, answers and paper excerpts are sent to LangSmith; set the HIDE flags to keep them out.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=researchmate
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
PRACTICE_TASK_POLL_SECONDS=1

# ===========================================
# User Preferences (Legacy/Default)
# ===========================================
USER_INTERESTS_STR=deep learning,large language models,AI agents,machine learning,reinforcement learning

# ===========================================
# API Configuration
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# Semantic Scholar API (strongly recommended)
# ===========================================
# Used by the citation-graph feed channel, reading paths and citation_refresh. Without a key
# every call shares one anonymous global rate limit: searches are often refused (429), and
# reading paths then fall back to this library's papers only. Free key:
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
